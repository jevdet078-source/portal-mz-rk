        "selector": "JSXOpeningElement[name.name='AvatarGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|size|max|className|style|key|ref|className|style|children)$/]",
        "message": "<AvatarGroup> doesn't accept that prop. Declared props: items, size, max, className, style."
